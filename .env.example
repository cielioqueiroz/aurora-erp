# Supabase (frontend)
# Pegue estes valores em https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Ambiente de execução
VITE_APP_ENV=development
VITE_APP_NAME=AURORA ERP

# Modo demo: true = pula login, injeta sessão fake de owner com todas as permissões.
# Útil para preview visual / apresentação sem criar conta. NUNCA use em produção.
VITE_DEMO_MODE=false
